<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Action Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/photo_editor_title"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/photo_undo"
                android:src="@drawable/ic_undo"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/photo_redo"
                android:src="@drawable/ic_redo"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#2E3832"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="步骤 1 / 1"
                android:textColor="#52B788"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnReset"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/photo_reset"
                android:src="@drawable/ic_restore"
                app:tint="#E0E0E0" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:backgroundTint="#2D6A4F"
            android:paddingHorizontal="12dp"
            android:text="@string/photo_save_use"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="19dp"
            app:icon="@drawable/ic_check"
            app:iconPadding="4dp"
            app:iconSize="16dp" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Canvas Container -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0A0A0A"
        app:layout_constraintBottom_toTopOf="@+id/toolControlContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/photo_editor_title"
            android:scaleType="fitCenter" />

        <software.homebox.android.ui.photo.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Floating File Size & Space Savings Indicator -->
        <TextView
            android:id="@+id/tvSizeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#D9212529"
            android:elevation="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="280 KB"
            android:textColor="#52B788"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Contextual Tool Controls Container -->
    <FrameLayout
        android:id="@+id/toolControlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:minHeight="80dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomTabBar">

        <!-- 1. Crop Controls -->
        <LinearLayout
            android:id="@+id/panelCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRatioFree"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/photo_ratio_free"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRatio1_1"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/photo_ratio_1_1"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRatio4_3"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/photo_ratio_4_3"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRatio16_9"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/photo_ratio_16_9"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyCrop"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#2D6A4F"
                android:text="@string/photo_apply"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="19dp" />
        </LinearLayout>

        <!-- 2. Rotate Controls -->
        <LinearLayout
            android:id="@+id/panelRotate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateCW"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/photo_rotate_cw"
                android:textSize="11sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_rotate_right"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateCCW"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/photo_rotate_ccw"
                android:textSize="11sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_rotate_left"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlipH"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/photo_flip_h"
                android:textSize="11sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_flip"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlipV"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/photo_flip_v"
                android:textSize="11sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_flip"
                app:iconSize="16dp" />
        </LinearLayout>

        <!-- 3. Filter Controls -->
        <LinearLayout
            android:id="@+id/panelFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterColor"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/photo_mode_color"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterBW"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/photo_mode_bw"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterDoc"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/photo_mode_doc"
                android:textSize="11sp"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- 4. Resolution Controls -->
        <LinearLayout
            android:id="@+id/panelResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes720"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="720p"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes1080"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="1080p"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes1600"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="1600p"
                android:textSize="11sp"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResOrig"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="原图"
                android:textSize="11sp"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- 5. Adjust Brightness & Contrast -->
        <LinearLayout
            android:id="@+id/panelAdjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrightnessLabel"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:text="亮度: 0"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbBrightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#52B788"
                    android:thumbTint="#52B788" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvContrastLabel"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:text="对比度: 0"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbContrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#52B788"
                    android:thumbTint="#52B788" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoEnhance"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/photo_auto_enhance"
                    android:textSize="11sp"
                    app:cornerRadius="17dp"
                    app:icon="@drawable/ic_tune"
                    app:iconSize="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyAdjust"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#2D6A4F"
                    android:text="@string/photo_apply"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Tab Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#181818"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/tabCrop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabCrop"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/photo_crop"
                android:src="@drawable/ic_crop"
                app:tint="#52B788" />

            <TextView
                android:id="@+id/tvTabCrop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/photo_crop"
                android:textColor="#52B788"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabRotate"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/photo_rotate"
                android:src="@drawable/ic_rotate_right"
                app:tint="#888888" />

            <TextView
                android:id="@+id/tvTabRotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/photo_rotate"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabFilter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabFilter"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/photo_filter"
                android:src="@drawable/ic_filter"
                app:tint="#888888" />

            <TextView
                android:id="@+id/tvTabFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/photo_filter"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabResolution"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabResolution"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/photo_resolution"
                android:src="@drawable/ic_compress"
                app:tint="#888888" />

            <TextView
                android:id="@+id/tvTabResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/photo_resolution"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAdjust"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabAdjust"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/photo_adjust"
                android:src="@drawable/ic_tune"
                app:tint="#888888" />

            <TextView
                android:id="@+id/tvTabAdjust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/photo_adjust"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
